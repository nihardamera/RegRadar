# Copy to .env (never committed) and fill in what you use.
# The model for /ask and /impact; there is no default.
REGRADAR_MODEL=claude-haiku-5-5
# 1 lets the API spend (capped by regradar.llm.BUDGET_USD); unset = dry run, cache only.
REGRADAR_SPEND=
# ANTHROPIC_API_KEY=  (or export it from your secret store per command; never commit it)
